<!doctype html><html lang="ru"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>AVITO AI — Admin</title><link rel="stylesheet" href="/styles.css"></head><body><header class="top"><a class="brand" href="/">AVITO<span>AI</span> ADMIN</a><a class="ghost" href="/">На сайт</a></header><main class="section"><div class="section-title"><span>ADMIN</span><h2>Панель управления</h2></div><div id="stats" class="plans"></div><h2 style="margin-top:50px">Пользователи</h2><div class="panel" style="overflow:auto"><table id="users" style="width:100%;border-collapse:collapse"><tbody></tbody></table></div><h2 style="margin-top:50px">Платежи</h2><div class="panel" style="overflow:auto"><table id="payments" style="width:100%;border-collapse:collapse"><tbody></tbody></table></div></main><script>async function api(u){const r=await fetch(u);const d=await r.json();if(!r.ok)throw Error(d.error||'Ошибка');return d}function esc(s){return String(s??'').replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;')}async function load(){try{const s=await api('/api/admin/stats');document.querySelector('#stats').innerHTML=[['Пользователей',s.users],['Анализов за 30 дней',s.analyses30d],['Оплачено заказов',s.paidOrders],['Выручка',s.revenue+' ₽']].map(x=>`<article><span>METRIC</span><h3>${x[1]}</h3><p>${x[0]}</p></article>`).join('');const u=await api('/api/admin/users');document.querySelector('#users tbody').innerHTML='<tr><th>ID</th><th>Имя</th><th>Email</th><th>Telegram</th><th>Тариф</th><th>Дата</th></tr>'+u.items.map(x=>`<tr><td>${x.id}</td><td>${esc(x.name)}</td><td>${esc(x.email||'—')}</td><td>${esc(x.telegram_id||'—')}</td><td>${x.plan}</td><td>${new Date(x.created_at).toLocaleString('ru-RU')}</td></tr>`).join('');const p=await api('/api/admin/payments');document.querySelector('#payments tbody').innerHTML='<tr><th>ID</th><th>Провайдер</th><th>Тариф</th><th>Сумма</th><th>Статус</th><th>Дата</th></tr>'+p.items.map(x=>`<tr><td>${x.id}</td><td>${x.provider}</td><td>${x.plan}</td><td>${x.amount} ${x.currency}</td><td>${x.status}</td><td>${new Date(x.created_at).toLocaleString('ru-RU')}</td></tr>`).join('')}catch(e){document.querySelector('main').insertAdjacentHTML('beforeend',`<div class="panel">${esc(e.message)}. Войдите как администратор на главной странице.</div>`)}}load()</script></body></html>
